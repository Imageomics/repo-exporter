GH_TOKEN=your-token-here
GH_ORG_NAME=your-github-org
SPREADSHEET_ID=your-google-sheet-id
GH_SHEET_NAME=GH-Repos

# Options: all, forks, sources, member (or combine with commas, e.g. forks,sources)
GH_REPO_TYPE=all
# Options: all, public, private
GH_REPO_VISIBILITY=all

HF_TOKEN=your-huggingface-token
HF_ORG_NAME=your-huggingface-org
HF_SHEET_NAME=HF-Repos

# Options: all, dataset, model, space (or combine with commas, e.g. model,dataset)
HF_REPO_TYPE=all
# Options: all, public, private
HF_REPO_VISIBILITY=all

GOOGLE_CREDENTIALS_PATH=/path/to/service_account.json

# How to report a repo whose fetch fails completely
# Options:
#   console - print to the console (default)
#   log     - print to the console and append to a log file
#   column  - print to the console and write the error to the sheet's Status column
ERROR_MODE=console

# To log errors to a file instead, comment out the ERROR_MODE line above
# and uncomment both lines below (ERROR_LOG_PATH is only used when ERROR_MODE=log):
# ERROR_MODE=log
# ERROR_LOG_PATH=repo_exporter_errors.log